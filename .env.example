# ==========================================
# Google Gemini API 設定 (必須)
# ==========================================
# Google AI Studio (https://aistudio.google.com/) で取得したAPIキー
GEMINI_API_KEY=your_gemini_api_key_here

# 使用するGeminiモデル (例: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# ライブドアブログ AtomPub API 設定 (任意: UIから手動コピーも可能)
# ==========================================
# ライブドアブログ管理画面 > ブログ設定 > API Key で確認できます
LIVEDOOR_ID=your_livedoor_id
LIVEDOOR_API_KEY=your_livedoor_api_key
# 自身のブログのAtomPubエンドポイント例: https://livedoor.blogcms.jp/atom/blog/{LIVEDOOR_ID}/article
# デフォルトで下書き保存するか (true/false)
LIVEDOOR_POST_DRAFT=true

# ==========================================
# X (Twitter) 公式 API 設定 (将来の拡張用 / 任意)
# ==========================================
# 有料プラン契約時に発行される認証情報
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
